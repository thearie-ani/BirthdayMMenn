# =================================================================
# BirthdayMMenn (BirthdayMate) - Environment Configuration Template
# Copy this file to '.env' and fill in your actual values.
# IMPORTANT: Never commit your real '.env' file or API keys to Git!
# =================================================================

# Telegram Bot Token (obtained from @BotFather on Telegram)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Database Configuration (SQLite database URL)
DATABASE_URL=sqlite+aiosqlite:///birthday_mmenn.db

# AI Service Configuration
AI_API_KEY=your_ai_api_key_here
# Optional Gemini Model Configuration
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_FALLBACK_MODEL=gemini-3-flash-preview

# Application Settings
DEFAULT_TIMEZONE=UTC
LOG_LEVEL=INFO
